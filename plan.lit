@s aseprite
--- install.txt +=
# google aseprite github
#
# explain this works but just to save space there is a better command git clone --recursive https://github.com/aseprite/aseprite.git
# git clone --depth 1 --recurse-submodules --shallow-submodules https://github.com/aseprite/aseprite.git
# install dependancies
sudo apt-get install -y g++ clang cmake ninja-build unzip libx11-dev libxcursor-dev libxi-dev libxrandr-dev libgl1-mesa-dev libfontconfig1-dev

./build.sh
---


